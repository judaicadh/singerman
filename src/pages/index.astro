---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Welcome";
const description = "Explore Robert Singerman’s Judaica Americana II";

// Theme Colors
const SCHOLAR_RED = "#b91c1c";
const SCHOLAR_BLACK = "#1a1a1a";
const SCHOLAR_PAPER = "#FCFAf7";
---

<BaseLayout {title} {description}>
    <section class="relative bg-[#FCFAf7] dark:bg-[#121212] min-h-[80vh] flex flex-col items-center justify-center text-center py-24 px-4">

        <div class="mb-6">
            <span class="text-[13px] uppercase tracking-[0.4em] text-[#b91c1c] dark:text-[#ff4d4d] font-black">
                Bibliographical Database
            </span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif text-[#1a1a1a] dark:text-[#e5e5e5] mb-6 italic leading-tight max-w-4xl">
            Robert Singerman’s <br><span class="text-[#b91c1c] dark:text-[#ff4d4d] not-italic font-bold">Judaica Americana II</span>
        </h1>

        <p class="text-xl sm:text-2xl font-serif text-gray-700 dark:text-gray-300 max-w-2xl mx-auto mb-12 leading-relaxed italic">
            An authoritative chronicle of American Jewish book and serial production from the seventeenth century to the twentieth century, expanded with 3,000 additional entries.
        </p>

        <div class="w-full max-w-2xl mx-auto">
            <form
                    action="/search"
                    method="GET"
                    class="relative group"
                    role="search"
                    aria-label="Search the bibliography"
            >
                <label for="hero-search" class="sr-only">Search by Author, Title, or Singerman ID</label>
                <input
                        id="hero-search"
                        type="search"
                        name="query"
                        placeholder="Search by Author, Title, or Singerman ID..."
                        class="w-full px-8 py-5 rounded-xl border-2 border-gray-200 dark:border-gray-700 bg-white dark:bg-[#1e1e1e] text-[#1a1a1a] dark:text-[#e5e5e5] placeholder-gray-400 dark:placeholder-gray-500 shadow-sm focus:outline-none focus:border-[#b91c1c] dark:focus:border-[#ff4d4d] focus:ring-0 transition-all font-serif text-lg italic"
                />
                <button
                        type="submit"
                        class="absolute right-3 top-1/2 -translate-y-1/2 bg-[#1a1a1a] dark:bg-[#b91c1c] text-white px-6 py-2.5 rounded-lg font-bold text-sm uppercase tracking-widest hover:bg-[#b91c1c] dark:hover:bg-[#ff4d4d] transition-colors"
                >
                    Search
                </button>
            </form>
        </div>

        <div class="mt-16 flex flex-wrap justify-center gap-8">
            <a href="/search" class="group flex flex-col items-center gap-2">
                <span class="text-[11px] uppercase tracking-widest text-gray-500 dark:text-gray-400 font-black group-hover:text-[#b91c1c] dark:group-hover:text-[#ff4d4d] transition-colors">Digital Archive</span>
                <span class="text-base font-bold text-[#1a1a1a] dark:text-[#e5e5e5] border-b-2 border-[#b91c1c] dark:border-[#ff4d4d] pb-1">Browse All Records</span>
            </a>
            <a href="/about/introduction" class="group flex flex-col items-center gap-2">
                <span class="text-[11px] uppercase tracking-widest text-gray-500 dark:text-gray-400 font-black group-hover:text-[#b91c1c] dark:group-hover:text-[#ff4d4d] transition-colors">Project History</span>
                <span class="text-base font-bold text-[#1a1a1a] dark:text-[#e5e5e5] border-b-2 border-[#b91c1c] dark:border-[#ff4d4d] pb-1">About the Second Edition</span>
            </a>
        </div>

        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-10 dark:opacity-20 pointer-events-none" aria-hidden="true">
            <span class="text-[12rem] font-serif italic text-[#b91c1c] dark:text-[#ff4d4d] select-none">S</span>
        </div>
    </section>
</BaseLayout>