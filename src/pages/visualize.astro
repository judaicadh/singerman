---
import BaseLayout from "../layouts/BaseLayout.astro";
import Dashboard from "../components/Dashboard";
import items from "../data/items.json";

/* ------------------------------------------------------------------ *
 * Build a compact payload for the client dashboard.
 *   langs   — fixed language buckets (index = colour index)
 *   places  — [name, lat, lng] deduped by place string
 *   records — [placeIdx, primaryLang, isSerial, years[], langMask] per
 *             geolocated imprint. `years` holds every publication year parsed
 *             from the record (serials often ran across many); years[0] is the
 *             primary year. `langMask` is a bitmask of every language bucket the
 *             work is in, so bilingual works count toward each of their languages.
 * ------------------------------------------------------------------ */
const LANGS = ["English", "Yiddish", "Hebrew", "German", "Other"];
const YMIN = 1600;
const YMAX = 1905; // clamp out stray/erroneous future years in serial runs

function bucket(lang: string): number {
  const l = (lang || "").replace(/\?/g, "").trim();
  if (l === "English") return 0;
  if (l.startsWith("Yiddish") || l.includes("Judeo-German")) return 1;
  if (l.startsWith("Hebrew") || l === "Aramaic") return 2;
  if (l.startsWith("German")) return 3;
  return 4;
}

/* Pull every 4-digit year out of the (possibly pipe-delimited) year field,
   e.g. "1892 | 1893 | 1903" → [1892, 1893, 1903]; primary year first. */
function parseYears(raw: unknown): number[] {
  const primary = parseInt(String(raw ?? "").slice(0, 4), 10);
  const found = String(raw ?? "").match(/1[6-9]\d\d/g) ?? [];
  const seen = new Set<number>();
  const out: number[] = [];
  const push = (n: number) => {
    if (Number.isFinite(n) && n >= YMIN && n <= YMAX && !seen.has(n)) {
      seen.add(n);
      out.push(n);
    }
  };
  push(primary);
  for (const m of found) push(parseInt(m, 10));
  return out;
}

const placeIndex = new Map<string, number>();
const places: [string, number, number][] = [];
// [placeIdx, primaryLang, isSerial, years[], langMask, isDigitized]
const records: [number, number, number, number[], number, number][] = [];

// Name → count, for the "most prolific" bar charts (built once here).
const authorCounts = new Map<string, number>();
const contribCounts = new Map<string, number>();
const tally = (m: Map<string, number>, v: unknown) => {
  for (const name of (Array.isArray(v) ? v : [v])) {
    const n = String(name ?? "").trim();
    if (n) m.set(n, (m.get(n) ?? 0) + 1);
  }
};
const topN = (m: Map<string, number>, n: number): [string, number][] =>
  [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, n);

let minYear = Infinity;
let maxYear = -Infinity;

for (const r of items as any[]) {
  // Skip withdrawn entries (description is exactly "Withdrawn") — not real imprints.
  if (String(r.description ?? "").trim().toLowerCase() === "withdrawn") continue;

  const ll = r.latLng;
  if (!ll || typeof ll.lat !== "number" || typeof ll.lng !== "number") continue;

  const years = parseYears(r.year);
  if (years.length === 0) continue;

  const name = (r.place || "Unknown").trim();
  let pi = placeIndex.get(name);
  if (pi === undefined) {
    pi = places.length;
    placeIndex.set(name, pi);
    places.push([name, ll.lat, ll.lng]);
  }

  const langList: string[] = Array.isArray(r.languages) ? r.languages.filter(Boolean) : [];
  const primaryLang = langList.length ? bucket(langList[0]) : 4; // blank → Other
  let langMask = 0;
  for (const l of langList) langMask |= 1 << bucket(l);
  if (langMask === 0) langMask = 1 << 4; // blank → Other
  // Serials are the "Union List of Nineteenth-Century Jewish Serials"
  // collection (735 records). NB: the id prefix is unreliable — the ~3,100
  // "supp####" supplement entries are additional monographs, not serials.
  const isSerial = /Serial/i.test(String(r.collection ?? "")) ? 1 : 0;
  const isDigitized = r.isDigitized ? 1 : 0;
  records.push([pi, primaryLang, isSerial, years, langMask, isDigitized]);

  tally(authorCounts, r.authors);
  tally(contribCounts, r.contributor);

  for (const y of years) {
    if (y < minYear) minYear = y;
    if (y > maxYear) maxYear = y;
  }
}

const topAuthors = topN(authorCounts, 12);
const topContributors = topN(contribCounts, 12);

/* ---- Growth figures for the narrative (computed from the FULL non-withdrawn,
   dated corpus by first year, so the prose stays in sync with the data). ---- */
const firstYearsAll: number[] = [];
for (const r of items as any[]) {
  if (String(r.description ?? "").trim().toLowerCase() === "withdrawn") continue;
  const ys = parseYears(r.year);
  if (ys.length) firstYearsAll.push(ys[0]);
}
const cum = (y: number) => firstYearsAll.filter((fy) => fy <= y).length;
const inc = (a: number, b: number) => firstYearsAll.filter((fy) => fy >= a && fy <= b).length;
const pct = (from: number, to: number) => (from ? Math.round(((to - from) / from) * 100) : 0);

const by1865 = cum(1865);
const target = by1865 * 2;
let doubleYear = maxYear;
for (let y = 1866; y <= YMAX; y++) {
  if (cum(y) >= target) { doubleYear = y; break; }
}
const growth = {
  pre1801: cum(1800),
  inc1801_1825: inc(1801, 1825),
  growth1: pct(cum(1800), inc(1801, 1825)),
  inc1826_1850: inc(1826, 1850),
  growth2: pct(inc(1801, 1825), inc(1826, 1850)),
  cw1860_1865: inc(1860, 1865),
  cw1861_1865: inc(1861, 1865),
  by1865,
  doubleYear,
  doubleCount: cum(doubleYear),
  doubleGrowth: pct(by1865, cum(doubleYear)),
};
---

<BaseLayout
  title="Visualization"
  description="Explore American Jewish imprints from 1676 to 1902 across time, place, and language on an interactive map and timeline."
>
  <Fragment slot="headContent">
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>
    {/* MapLibre GL + Leaflet bridge → renders CARTO's vector Positron basemap */}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.min.css" crossorigin="" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.min.js" crossorigin=""></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js"></script>
  </Fragment>

  <Dashboard
    client:only="react"
    places={places}
    records={records}
    langs={LANGS}
    minYear={minYear}
    maxYear={maxYear}
    cartoKey={import.meta.env.PUBLIC_CARTO_API_KEY ?? ""}
    topAuthors={topAuthors}
    topContributors={topContributors}
    growth={growth}
  />
</BaseLayout>
