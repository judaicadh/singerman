---
import entries from '../../data/items.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../utils/slugify.js';
type Item = {
    id: string;
    asterix: string;
    slug: string;
    title: string;
    authors?: string[];
    description?: string;
    contributor?: string[];
    startDate?: number;
    endDate?: number;
    year?: string;
    languagetitle?: string | string[];
    goldmanTitle?: string;
    goldmanId?: string;
    languages?: string | string[];
    place?: string;
    collection?: string;
    notes?: string;
    holdings?: string[];
    thumbnail: string;
    isDigitized?: boolean;
    iframe?: string;
    url?: string;
    latLng?: { lat: number; lng: number };
};


const getSchemaType = (collection) => {
    if (!collection) return "Book";
    const lower = collection.toLowerCase();
    if (
        lower.includes("periodical") ||
        lower.includes("serial") ||
        lower.includes("journal") ||
        lower.includes("newspaper")
    ) {
        return "Periodical";
    }
    return "Book";
};
// ✅ Get slug from Astro.params (in static mode)
const { slug } = Astro.params;
const item = entries.find((entry) => entry.slug === slug);
export async function getStaticPaths() {
    return entries.map((entry: Item) => ({
        params: { slug: entry.slug },
    }));
}
if (!item) {
    throw new Error(`❌ No item found for slug: ${slug}`);
}

const formatDate = (
    start?: number,
    end?: number,
    fallbackYear?: string
): string | null => {
    const toYear = (ts?: number): number | null =>
        typeof ts === 'number' && !isNaN(ts)
            ? new Date(ts * 1000).getUTCFullYear()
            : null;

    const startYear = toYear(start);
    const endYear = toYear(end);

    if (startYear && endYear && startYear !== endYear) {
        return `${startYear}–${endYear}`;
    }

    return startYear?.toString() ?? endYear?.toString() ?? fallbackYear ?? null;
};
const isPersonallyViewed = item.asterisk === "*";
const displayDate = formatDate(item.startDate, item.endDate, item.year);

const breadcrumb = item.collection || "Chronological File, 1676 to 1900";

const googleBooksUrl = `https://www.google.com/search?tbm=bks&q=${encodeURIComponent(item.title)}`;
---
<BaseLayout title={item.title}>
    <main class="bg-[#FCFAf7] dark:bg-[#121212] min-h-screen max-w-7xl mx-auto px-4 sm:px-8 py-8 md:py-16 text-[#1a1a1a] dark:text-[#e5e5e5] transition-colors duration-300">

        <div class="mb-8">
            <a href="/" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400 hover:text-[#b91c1c] dark:hover:text-[#ff4d4d] transition-colors group">
                <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                Back to Archive
            </a>
        </div>

        <header class="mb-12">
            <div class="flex flex-row justify-between items-center border-b-2 border-[#b91c1c] pb-3 mb-8">
                <nav class="text-[11px] uppercase tracking-[0.2em] text-[#b91c1c] dark:text-[#ff4d4d] font-black">
                    {breadcrumb}
                </nav>
                <div class="flex items-center gap-3">
                    {isPersonallyViewed && (
                            <span class="text-[#b91c1c] dark:text-[#ff4d4d] text-xl" title="Personally viewed by Robert Singerman">★</span>
                    )}
                    <div class="flex flex-col items-end leading-none">
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 dark:text-gray-400 font-bold">Singerman ID</span>
                        <span class="text-base font-mono font-bold text-black dark:text-white">#{item.id}</span>
                    </div>
                </div>
            </div>

            <h1 class="text-xl md:text-xl lg:text-xl font-serif text-black dark:text-white leading-tight italic max-w-5xl">
                {item.title}
            </h1>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            <div class="lg:col-span-8 ">

                    {item.iframe ? (
                            <div class="  w-full pb-4  flex items-center justify-center" set:html={item.iframe}></div>
                    ) : (

                        <></>

                    )}


                <article class="bg-white dark:bg-[#1e1e1e] px-6 py-6   rounded-lg border-t-4 border-[#b91c1c] shadow-md relative dark:shadow-none">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end border-b border-gray-100 dark:border-gray-800 pb-4 mb-8 gap-4 sm:gap-0">
                        <h2 class="text-md align-middle uppercase tracking-[0.2em] text-gray-400 font-black">
                            Singerman Entry
                        </h2>

                        <div class="flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-start bg-gray-50 dark:bg-gray-800 sm:bg-transparent p-2 sm:p-0 rounded">
                            <span class="text-[10px] uppercase tracking-widest text-gray-500 font-bold sm:mb-1">Singerman ID</span>
                            <span class="text-sm font-mono font-bold text-[#b91c1c] dark:text-[#ff4d4d] sm:bg-gray-50 dark:sm:bg-gray-800 sm:px-2.5 sm:py-1 sm:border sm:border-gray-200 dark:sm:border-gray-700 rounded">
                                #{item.id}
                            </span>
                        </div>
                    </div>

                    <p class="text-md md:text-md font-serif leading-[1.7] md:leading-[1.8] text-gray-900 dark:text-gray-200 ">
                        {item.description}
                    </p>

                    {item.notes && (
                            <div class="mt-4 md:mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
                                <h3 class="text-[10px] md:text-xs uppercase tracking-widest text-[#b91c1c] dark:text-[#ff4d4d] font-bold mb-4">
                                    Notes
                                </h3>
                                <p class="text-base md:text-sm  text-gray-700 dark:text-gray-400 leading-relaxed font-serif">
                                    {item.notes}
                                </p>
                            </div>
                    )}
                </article>
            </div>

            <aside class="lg:col-span-4 space-y-6">
                <div class="bg-white dark:bg-[#1e1e1e] p-6 rounded-lg border border-gray-200 dark:border-gray-800 shadow-sm">
                    <div class="flex items-center justify-between border-b-2 border-[#b91c1c] pb-3 mb-6">
                        <h3 class="text-md font-black uppercase tracking-[0.2em] text-black dark:text-white">
                            Bibliographic Metadata
                        </h3>
                        {item.asterisk === "*" && (
                                <span class="text-[#b91c1c] dark:text-[#ff4d4d] text-sm font-black bg-red-50 dark:bg-red-950/30 px-2 py-0.5 rounded">
                                VIEWED ★
                            </span>
                        )}
                    </div>

                    <div class="space-y-6">
                        {item.authors && (
                                <div>
                                    <label class="block text-[10px] font-black text-[#b91c1c] dark:text-[#ff4d4d] uppercase mb-1">Author / Editor</label>
                                    <div class="flex flex-wrap gap-x-2">
                                        {item.authors.map(author => (
                                                <a href={`/author/${slugify(author)}`} class="text-[15px] text-black dark:text-gray-200 font-bold hover:text-[#b91c1c] dark:hover:text-[#ff4d4d] transition-colors underline decoration-gray-200 dark:decoration-gray-700 underline-offset-4">
                                                    {author}
                                                </a>
                                        ))}
                                    </div>
                                </div>
                        )}
                        <div class="space-y-4">

                            {item.contributor && item.contributor.length > 0 && (

                                    <div class="pt-4 border-t border-gray-100">

                                        <label class="block text-[10px] font-black text-[#b91c1c] uppercase mb-1">Printer/Publisher</label>

                                        <div class="flex flex-wrap gap-x-2">

                                            {item.contributor.map(c => (

                                                    <a href={`/contributor/${slugify(c)}`} class="text-[15px] text-black font-bold hover:text-[#b91c1c] transition-colors underline decoration-gray-200 underline-offset-4">

                                                        {c}

                                                    </a>

                                            ))}

                                        </div>

                                    </div>

                            )}

                        </div>


                        <div class="pt-4 border-t border-gray-100 dark:border-gray-800 grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-black text-gray-400 uppercase mb-1">Location</label>
                                <span class="text-sm font-bold text-black dark:text-gray-200">{item.place}</span>
                            </div>
                            <div>
                                <label class="block text-[10px] font-black text-gray-400 uppercase mb-1">Year</label>
                                <span class="text-sm font-bold text-black dark:text-gray-200">{item.year}</span>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-gray-100 dark:border-gray-800 space-y-4">

                            <div>
                                <label class="block text-[10px] font-black text-gray-400 uppercase mb-1.5">Language</label>
                                <div class="flex flex-wrap gap-2">
                                    {Array.isArray(item.languages) ? (
                                        item.languages.map((lang) => (
                                                <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-black dark:text-gray-300 text-[13px] font-bold rounded border border-gray-200 dark:border-gray-700">
                                                {lang}
                                            </span>
                                        ))
                                    ) : (
                                            <span class="text-base font-bold text-black dark:text-gray-200">{item.languages}</span>
                                    )}
                                </div>
                            </div>
                        </div>

                        {(item.goldmanId || item.goldmanTitle) && (
                                <div class="pt-4 border-t border-gray-100 dark:border-gray-800 space-y-3">
                                    <div class="flex justify-between items-center">
                                        <label class="text-[10px] font-black text-[#b91c1c] dark:text-[#ff4d4d] uppercase">Goldman No.</label>
                                        <span class="text-sm font-mono font-bold bg-white dark:bg-gray-800 px-2 py-0.5 border border-gray-200 dark:border-gray-700 rounded dark:text-gray-300">
                                        {item.goldmanId ? `GK-${item.goldmanId}` : 'N/A'}
                                    </span>
                                    </div>
                                    {item.goldmanTitle && (
                                            <div>
                                                <label class="block text-[10px] font-black text-[#b91c1c] dark:text-[#ff4d4d] uppercase mb-1">Goldman Title</label>
                                                <p class="text-base leading-relaxed text-gray-700 dark:text-gray-400 italic font-serif">
                                                    {item.goldmanTitle}
                                                </p>
                                            </div>
                                    )}
                                </div>
                        )}

                        <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                            <div class="flex items-center justify-between mb-3">
                                <label class="block text-[10px] font-black text-[#b91c1c] dark:text-[#ff4d4d] uppercase">Holdings</label>
                                <a href="/library-symbols" class="text-[9px] font-bold text-gray-400 hover:text-black dark:hover:text-white underline underline-offset-2">LIBRARY SYMBOLS ↗</a>
                            </div>
                            <div class="flex flex-wrap gap-1.5">
                                {item.holdings?.map(h => (
                                        <a href={`/holding/${slugify(h)}`} class="px-2.5 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded text-[10px] font-bold text-gray-600 dark:text-gray-400 hover:border-[#b91c1c] hover:text-[#b91c1c] transition-all">
                                            {h}
                                        </a>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                <a href={googleBooksUrl} target="_blank" class="flex items-center justify-center gap-2 px-6 py-4 bg-[#1a1a1a] dark:bg-white dark:text-black text-white rounded-lg hover:bg-[#b91c1c] dark:hover:bg-[#ff4d4d] dark:hover:text-white transition-all text-[11px] font-black uppercase tracking-widest group">
                    Search External Catalog
                </a>
            </aside>
        </div>
    </main>
</BaseLayout>